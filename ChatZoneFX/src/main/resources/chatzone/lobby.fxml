<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="chatzone.LobbyController"
           styleClass="root-bg-lobby"
           prefWidth="860" prefHeight="600">

    <VBox spacing="22" alignment="TOP_CENTER">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="lobby-header">
            <Label text="💬" styleClass="brand-badge"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="ChatZone" styleClass="lobby-title"/>
                <Label text="Escolha uma sala e entre na conversa" styleClass="lobby-tagline"/>
            </VBox>
            <Button text="👤" styleClass="user-btn" onAction="#onUserBtn"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Salas públicas" styleClass="section-title"/>
                <Label text="Clique em uma sala disponível para entrar" styleClass="section-subtitle"/>
            </VBox>
            <Button text="+  Criar sala" styleClass="btn-secondary" onAction="#onCreateRoom"/>
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="rooms-scroll" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="roomsGrid" hgap="18" vgap="18" styleClass="rooms-grid">
                <padding><Insets top="6" right="6" bottom="12" left="6"/></padding>
            </FlowPane>
        </ScrollPane>
    </VBox>

    <StackPane fx:id="profileModal" styleClass="modal-overlay" visible="false"
               onMouseClicked="#onModalClose">
        <VBox styleClass="modal" maxWidth="320" maxHeight="-Infinity" spacing="16" alignment="TOP_CENTER"
              onMouseClicked="#onModalInnerClick">
            <HBox alignment="CENTER_LEFT">
                <Label text="Meu perfil" styleClass="modal-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="modal-close" onAction="#onModalClose"/>
            </HBox>
            <Label text="👤" styleClass="profile-avatar"/>
            <VBox spacing="4" styleClass="profile-card" maxWidth="Infinity">
                <Label text="CONTA" styleClass="profile-label"/>
                <Label fx:id="profileEmailLabel" text="—" styleClass="profile-value" wrapText="true"/>
            </VBox>
            <Button text="Sair da conta" styleClass="btn-logout" maxWidth="Infinity" onAction="#onLogout"/>
        </VBox>
    </StackPane>

</StackPane>
