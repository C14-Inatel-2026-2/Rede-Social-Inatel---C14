<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="chatzone.ChatController"
      styleClass="chat-container"
      prefWidth="720" prefHeight="600">

    <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="12">
        <Button text="←" styleClass="back-btn" onAction="#onBack"/>
        <Label text="#" styleClass="room-avatar"/>
        <VBox spacing="2">
            <Label fx:id="roomNameLabel" text="Sala" styleClass="chat-room-name"/>
            <Label fx:id="usersCountLabel" text="conectando…" styleClass="users-count"/>
        </VBox>
    </HBox>

    <ScrollPane fx:id="messagesScroll" styleClass="messages-scroll"
                fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="messagesBox" styleClass="chat-messages" spacing="8">
            <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        </VBox>
    </ScrollPane>

    <HBox styleClass="chat-input-area" alignment="CENTER" spacing="10">
        <padding><Insets top="12" right="18" bottom="12" left="18"/></padding>
        <TextArea fx:id="msgInput"
                  promptText="Escreva uma mensagem…  (Enter envia · Shift+Enter quebra linha)"
                  styleClass="msg-input"
                  prefRowCount="1"
                  wrapText="true"
                  HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendBtn" text="➤" styleClass="send-btn" onAction="#onSend" disable="true"/>
    </HBox>

</VBox>
