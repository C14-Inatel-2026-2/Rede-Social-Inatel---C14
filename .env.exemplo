# Administrador Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=sua-senha

# Informações para o jenkins acessar o GitHub
GITHUB_USER=seu-usuario
GITHUB_TOKEN=github_path_xxxxxxx
GITHUB_REPO_URL=url-do-projeto

# Render deploy hook for the main branch
RENDER_DEPLOY_HOOK=webhook-do-render

# Webhook do discord
DISCORD_WEBHOOK=webhook-do-canal

# Database
DB_NAME=db
DB_USER=seu-user
DB_PASSWORD=sua-senha